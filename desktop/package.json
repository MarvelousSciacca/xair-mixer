{
  "name": "airdesk",
  "productName": "AirDesk",
  "version": "1.0.0",
  "description": "Controller per mixer digitali compatibili con Behringer X Air (XR12/XR16/XR18). Non affiliato con Behringer o Music Tribe.",
  "author": "MarvelousSciacca",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "prepare-app": "rm -rf public server && cp -R ../public ../server . && cp ../LICENSE ../THIRD-PARTY-NOTICES.md ../PRIVACY.md .",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --publish never"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "it.airdesk.desktop",
    "productName": "AirDesk",
    "artifactName": "AirDesk-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "public/**",
      "server/**",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "PRIVACY.md"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AirDesk-Setup.${ext}",
      "license": "LICENSE"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "maintainer": "MarvelousSciacca <https://github.com/MarvelousSciacca>"
    },
    "afterSign": "build/adhoc-sign.cjs",
    "copyright": "Copyright © 2026 MarvelousSciacca",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  },
  "homepage": "https://github.com/MarvelousSciacca/xair-mixer",
  "license": "MIT"
}
